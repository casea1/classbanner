<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>ClassBanner</displayName>
  <description>Classification banner settings</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_ClassBanner1">ClassBanner 1.0 or later</string>
      <string id="Cat_ClassBanner">ClassBanner</string>
      <string id="Cat_Appearance">Appearance</string>
      <string id="Cat_Desktop">Desktop enforcement</string>

      <string id="Level">Classification level</string>
      <string id="Level_Help">Sets the classification shown on the banner. Each level uses its standard marking and color:

UNCLASSIFIED (green), CUI (purple), CONFIDENTIAL (blue), SECRET (red), TOP SECRET (orange), TOP SECRET//SCI (yellow).

Use "Banner text" to add caveats such as //NOFORN. Group Policy overrides the machine settings file.</string>
      <string id="Level_U">UNCLASSIFIED</string>
      <string id="Level_CUI">CUI</string>
      <string id="Level_C">CONFIDENTIAL</string>
      <string id="Level_S">SECRET</string>
      <string id="Level_TS">TOP SECRET</string>
      <string id="Level_TSSCI">TOP SECRET//SCI</string>

      <string id="Caption">Banner text</string>
      <string id="Caption_Help">Replaces the standard marking text, for example "SECRET//NOFORN". The banner color still comes from the classification level unless "Banner colors" is also set.</string>

      <string id="Colors">Banner colors</string>
      <string id="Colors_Help">Overrides the level's standard colors. Use #RRGGBB, for example #C8102E. Leave a box empty to keep the standard color.</string>

      <string id="Position">Banner position</string>
      <string id="Position_Help">Shows the banner at the top, bottom, or both edges of every monitor.</string>
      <string id="Position_Both">Top and bottom</string>
      <string id="Position_Top">Top only</string>
      <string id="Position_Bottom">Bottom only</string>

      <string id="BannerThickness">Banner thickness</string>
      <string id="BannerThickness_Help">Height of each banner in pixels at 100% display scaling (12-120), scaled for each monitor's display scaling. The default is 15; 0 sizes the banner to fit the text. In a thin banner the text is made smaller to fit.</string>
      <string id="FontSize">Text size</string>
      <string id="FontSize_Help">Banner text size in points (8-36, default 10). The banner is automatically scaled for each monitor's display scaling (100%, 125%, 150%, 200%...).</string>

      <string id="HoverTransparency">Transparency when the mouse is over the banner</string>
      <string id="HoverTransparency_Help">How see-through the banner becomes while the mouse is over it, so text underneath can be read (0-90 percent, default 40). 0 keeps it solid.</string>

      <string id="StayAboveFullScreenApps">Keep banner above full-screen applications</string>
      <string id="StayAboveFullScreenApps_Help">When enabled (default), the banner stays visible over full-screen presentations and video. When disabled, full-screen applications may cover it.</string>

      <string id="AllowUserExit">Allow users to close the banner</string>
      <string id="AllowUserExit_Help">When enabled, the banner's right-click menu has an Exit item. Disabled by default.</string>

      <string id="Clock">Show clock</string>
      <string id="Clock_Help">Shows the date and time on the right side of the banner.

Format uses .NET date/time format codes. %TZI% is replaced by Z (Zulu) or L (local). Examples:
  ddd dd-MMM-yy HH:mm%TZI%   (default)
  ddHHmm%TZI% MMM yy          (military date-time group, with Uppercase: 071830Z OCT 26)</string>

      <string id="EnforceColors">Color Windows title bars and highlights</string>
      <string id="EnforceColors_Help">When enabled (default), each user's window title bars, accent color and selection highlight are set to the classification color when they sign in.</string>

      <string id="Wallpaper">Desktop wallpaper</string>
      <string id="Wallpaper_Help">Sets each user's wallpaper when they sign in.

Generated: a solid classification-colored background with the marking in the middle.
Image: the image file given below (BMP, JPG or PNG; environment variables allowed).
Off: the wallpaper is not changed.</string>
      <string id="Wallpaper_Generated">Generated classification wallpaper</string>
      <string id="Wallpaper_Image">Image file</string>
      <string id="Wallpaper_Off">Off</string>

      <string id="ScreenSaver">Classification screen saver</string>
      <string id="ScreenSaver_Help">When enabled, each user's screen saver is set to the ClassBanner classification screen saver (the marking scrolling across every monitor) with the given timeout.

Domain alternative: enable "Force specific screen saver" (User Configuration > Administrative Templates > Control Panel > Personalization) with %ProgramFiles%\ClassBanner\ClassBanner.scr.</string>
    </stringTable>
    <presentationTable>
      <presentation id="Level">
        <dropdownList refId="Level" defaultItem="0" noSort="true">Classification:</dropdownList>
      </presentation>
      <presentation id="Caption">
        <textBox refId="Caption">
          <label>Banner text:</label>
        </textBox>
      </presentation>
      <presentation id="Colors">
        <textBox refId="BackColor">
          <label>Banner color (#RRGGBB):</label>
        </textBox>
        <textBox refId="ForeColor">
          <label>Text color (#RRGGBB):</label>
        </textBox>
      </presentation>
      <presentation id="Position">
        <dropdownList refId="Position" defaultItem="0" noSort="true">Position:</dropdownList>
      </presentation>
      <presentation id="BannerThickness">
        <decimalTextBox refId="BannerThickness" defaultValue="15">Thickness (pixels, 0 = automatic):</decimalTextBox>
      </presentation>
      <presentation id="FontSize">
        <decimalTextBox refId="FontSize" defaultValue="10">Text size (points):</decimalTextBox>
      </presentation>
      <presentation id="HoverTransparency">
        <decimalTextBox refId="HoverTransparency" defaultValue="40">Transparency (percent):</decimalTextBox>
      </presentation>
      <presentation id="Clock">
        <textBox refId="ClockFormat">
          <label>Format:</label>
          <defaultValue>ddd dd-MMM-yy HH:mm%TZI%</defaultValue>
        </textBox>
        <checkBox refId="ClockUseZulu" defaultChecked="false">Show Zulu (UTC) time</checkBox>
        <checkBox refId="ClockUppercase" defaultChecked="false">Uppercase</checkBox>
      </presentation>
      <presentation id="Wallpaper">
        <dropdownList refId="WallpaperMode" defaultItem="0" noSort="true">Wallpaper:</dropdownList>
        <textBox refId="WallpaperImagePath">
          <label>Image file (for "Image file"):</label>
        </textBox>
      </presentation>
      <presentation id="ScreenSaver">
        <decimalTextBox refId="ScreenSaverTimeoutSeconds" defaultValue="600">Start after (seconds):</decimalTextBox>
        <checkBox refId="ScreenSaverRequirePassword" defaultChecked="true">Require password to unlock</checkBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
